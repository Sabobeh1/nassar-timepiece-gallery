# ─────────────────────────────────────────────────────────────────────
# Supabase CLI — env template (operator credentials, NOT runtime secrets)
# Copy to `.env` and fill in. Never commit `.env`.
#
# Used only by `supabase link`, `supabase db push`, etc.
# ─────────────────────────────────────────────────────────────────────

SUPABASE_PROJECT_REF=rropzppodfgzvhkbtlrl

# DB password — Settings → Database → Connection string
SUPABASE_DB_PASSWORD=

# Personal access token — https://supabase.com/dashboard/account/tokens
# Generate one per developer; revoke when they leave.
SUPABASE_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Backend bot service — env template
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://rropzppodfgzvhkbtlrl.supabase.co
# Service-role key — fetch from Supabase dashboard:
#   Settings → API → Project API keys → service_role
# NEVER share, NEVER commit. Bypasses RLS. Bot-only.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CORS — comma-separated list in production, never `*` once live
ALLOWED_ORIGIN=http://localhost:5173

# Cron — Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Telegram (per-client tokens are stored in clients.telegram_bot_token;
# this var is only a fallback for development against a single test bot)
TELEGRAM_BOT_TOKEN=

# Used by scripts/setTelegramWebhook.ts
BACKEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

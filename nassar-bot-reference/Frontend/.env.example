# ─────────────────────────────────────────────────────────────────────
# Frontend — env template
# Copy to `.env` and fill in. Never commit `.env`.
#
# IMPORTANT: VITE_* values are bundled into the public JS. Treat them as
# public. NEVER put a service-role key, OpenAI key, or Telegram token here.
# ─────────────────────────────────────────────────────────────────────

# Public Backend base URL — the widget posts to ${VITE_BACKEND_URL}/api/webhook
VITE_BACKEND_URL=http://localhost:3000

# Optional default client slug for local dev (used when the host page
# does NOT provide <script data-client-slug="...">).
VITE_DEFAULT_CLIENT_SLUG=

# Supabase (only if the storefront talks to Supabase directly).
# These are PUBLIC by design — anon key is protected by RLS policies.
VITE_SUPABASE_URL=https://rropzppodfgzvhkbtlrl.supabase.co
VITE_SUPABASE_ANON_KEY=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.0",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-embeddings",
      "schedule": "0 3 * * *"
    }
  ]
}
